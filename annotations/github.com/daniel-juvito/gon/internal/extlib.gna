schema: 1
package: github.com/daniel-juvito/gon/internal/extlib
description: "Reference external-package annotation (in-module proof)"

functions:
  Take:
    params:
      - "!*string"
    results:
      - "error"

  Echo:
    params:
      - "string"
    results:
      - "string"

  Open:
    results:
      - "!io.Reader"

  Unwrap:
    params:
      - "!*X"
    results:
      - "!*X"

  Pick:
    params:
      - "!S"
    results:
      - "!S"

methods:
  Box.Get:
    results:
      - "!*X"

  Box.Ptr:
    params:
      - "!P"
    results:
      - "!P"

  Handle.Put:
    params:
      - "![]byte"
    results:
      - "error"

types:
  Box:
    fields:
      V: "!*X"
  Conn:
    fields:
      DB: "!*Handle"
      Log: "!*Handle"
      W: "!io.Writer"
  Base:
    fields:
      Root: "!*Handle"
  Wrapped:
    fields:
      Name: "!*Handle"
