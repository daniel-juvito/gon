Checker fixtures. The want part lists "LINE CODE" for every diagnostic that the
checker must report (empty: none). Written by hand from the RFC, section 6.2 to
6.6 and the decisions D3a, D3b and D3d of the interface RFC.

-- FL-NIL-01/src --
package p

type T struct{}

func f() {
	var a !*T = nil
	var b ![]int = nil
	var c !map[string]int = nil
	var d !chan int = nil
	var e !func() = nil
	_, _, _, _, _ = a, b, c, d, e
}
-- FL-NIL-01/want --
6 GN001
7 GN001
8 GN001
9 GN001
10 GN001
-- FL-SIL-01/src --
package p

type T struct{}

type S struct{ nn !*T }

func mk() !*T { return &T{} }

func f(p !*T, s S) {
	var a !*T = &T{}
	var b !*T = new(T)
	var c ![]int = make([]int, 0)
	var d !map[string]int = map[string]int{}
	var e !chan int = make(chan int)
	var g !func() = func() {}
	var h !*T = p
	var i !*T = mk()
	var j !*T = s.nn
	_, _, _, _, _, _, _, _, _ = a, b, c, d, e, g, h, i, j
}
-- FL-SIL-01/want --
-- FL-IF-01/src --
package p

type R interface{ M() }

type RW interface {
	R
	W()
}

type C struct{}

func (*C) M() {}

func f(r R, rw !RW) {
	var a !R = r
	var b !R = &C{}
	var c !R = rw
	_, _, _ = a, b, c
}
