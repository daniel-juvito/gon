-- GW-S-01/src --
package p

type T struct{}

type S struct {
	p !*T
}

type M struct{}

func (M) take(p !*T) {}

func take(p !*T) {}

func ret(q *T) !*T {
	return q
}

func multi(q *T) (!*T, error) {
	return q, nil
}

func f(q *T, p !*T) {
	p = q
	take(q)
	var m M
	m.take(q)
	_ = S{p: q}
	_ = S{q}
	_ = []!*T{q}
}
